{
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "trivy",
          "rules": [
            {
              "id": "CVE-2024-1234",
              "name": "SQL Injection",
              "shortDescription": {
                "text": "SQL injection vulnerability"
              },
              "fullDescription": {
                "text": "SQL injection vulnerability in query builder"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "high"
              }
            },
            {
              "id": "CVE-2024-5678",
              "name": "XSS",
              "shortDescription": {
                "text": "Cross-site scripting vulnerability"
              },
              "fullDescription": {
                "text": "XSS vulnerability in template rendering"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "high"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CVE-2024-1234",
          "message": {
            "text": "SQL injection in query"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/db.go"
                },
                "region": {
                  "startLine": 42,
                  "endLine": 42
                }
              }
            }
          ]
        },
        {
          "ruleId": "CVE-2024-5678",
          "message": {
            "text": "XSS vulnerability in template"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/template.go"
                },
                "region": {
                  "startLine": 100,
                  "endLine": 100
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
