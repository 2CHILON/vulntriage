# Database (orchestrator)
DATABASE_URL=postgres://postgres:postgres@postgres:5432/vulntriage

# Context builder (orchestrator)
SOURCE_DIR=../testdata/sample-repo
CONTEXT_LINES=20

# LLM Service URL (orchestrator → llm-service)
LLM_SERVICE_URL=http://localhost:8000

# LLM Client timeout in seconds (orchestrator; default 30)
LLM_CLIENT_TIMEOUT_SECONDS=30

# Analysis service configuration (orchestrator)
ANALYSIS_CONCURRENCY=4
ANALYSIS_MIN_SEVERITY=medium
ANALYSIS_MAX_FINDINGS=100
ANALYSIS_TIMEOUT_SECONDS=300

# LLM Service provider selection
LLM_PROVIDER=mock
# TODO(REAL-LLM): Set to real provider name when implementing real LLM
LLM_API_KEY=
# TODO(REAL-LLM): API key for real provider
LLM_MODEL=
# TODO(REAL-LLM): Model identifier for real provider

