# Database (orchestrator)
DATABASE_URL=postgres://postgres:postgres@postgres:5432/vulntriage

# Context builder (orchestrator)
SOURCE_DIR=../testdata/sample-repo
CONTEXT_LINES=20

# LLM Service
LLM_PROVIDER=mock
# TODO(REAL-LLM)
LLM_API_KEY=
# TODO(REAL-LLM)
LLM_MODEL=
# TODO(REAL-LLM)

# LLM analysis (orchestrator -> llm-service)
# Base URL of the LLM service. docker-compose sets http://llm-service:8000 for the container.
LLM_SERVICE_URL=http://localhost:8000
# Timeout per /analyze request in seconds (one retry on network errors and 5xx).
LLM_CLIENT_TIMEOUT_SECONDS=30
# Number of findings analyzed in parallel.
ANALYSIS_CONCURRENCY=4
# Findings below this severity (critical|high|medium|low) are stored as "skipped", never sent.
ANALYSIS_MIN_SEVERITY=medium
# Cost guard: at most this many findings are sent per analyze call; the rest are not_attempted.
ANALYSIS_MAX_FINDINGS=100
# Overall deadline for one analyze call in seconds; also sets the HTTP server write timeout (+15s).
ANALYSIS_TIMEOUT_SECONDS=300
